{
  "name": "nuxt-app",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": {
    "name": "Daniel Roe",
    "email": "daniel@roe.dev",
    "url": "https://roe.dev"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "lint": "eslint .",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "test:types": "vue-tsc -b --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:browser:update": "docker run --rm --network host -v $(pwd):/work/ -v /tmp/playwright-node-modules:/work/node_modules -w /work/ -it mcr.microsoft.com/playwright:v1.59.1-noble bash -c 'corepack enable && pnpm i && pnpm playwright test --update-snapshots'"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/scripts": "^1.0.6",
    "@nuxtjs/html-validator": "^2.1.0",
    "@takumi-rs/core": "^2.0.0",
    "nuxt": "^4.4.4",
    "nuxt-og-image": "^6.5.0",
    "unplugin-vue-router": "^0.19.2",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "1.62.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.9.0",
    "happy-dom": "20.11.6",
    "nano-staged": "1.0.2",
    "playwright-core": "1.62.1",
    "simple-git-hooks": "2.13.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged"
  },
  "packageManager": "pnpm@11.22.0",
  "nano-staged": {
    "*.{js,ts,mjs,cjs,json,.*rc}": [
      "npx eslint --fix"
    ]
  }
}
