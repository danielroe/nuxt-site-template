{
  "name": "nuxt-app",
  "license": "MIT",
  "private": true,
  "type": "module",
  "author": {
    "name": "Daniel Roe",
    "email": "daniel@roe.dev",
    "url": "https://roe.dev"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "lint": "eslint .",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "test:types": "vue-tsc -b --noEmit",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:browser": "playwright test test/browser",
    "test:browser:update": "docker run --rm --network host -v $(pwd):/work/ -v /tmp/playwright-node-modules:/work/node_modules -w /work/ -it mcr.microsoft.com/playwright:v1.55.0-noble bash -c 'corepack enable && pnpm i && pnpm playwright test test/browser --update-snapshots'"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/image": "^2.0.0",
    "@nuxt/scripts": "^0.13.0",
    "@nuxtjs/html-validator": "^2.1.0",
    "nuxt": "^4.0.3",
    "nuxt-og-image": "^5.1.9",
    "unplugin-vue-router": "^0.16.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "3.20.1",
    "@playwright/test": "1.56.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.1",
    "happy-dom": "20.0.10",
    "lint-staged": "16.2.6",
    "simple-git-hooks": "2.13.1",
    "typescript": "5.9.3",
    "vitest": "4.0.8",
    "vue-tsc": "3.1.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,json,.*rc}": [
      "npx eslint --fix"
    ]
  },
  "packageManager": "pnpm@10.20.0"
}
